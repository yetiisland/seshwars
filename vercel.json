{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/spot/:slug", "destination": "/api/spot/:slug" },
    { "source": "/((?!api/|.well-known/).*)", "destination": "/index.html" }
  ]
}
